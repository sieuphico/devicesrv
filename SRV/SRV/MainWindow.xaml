<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SRV.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SRV"
    xmlns:data="using:SRV.Data"
    xmlns:viewmodels="using:SRV.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Title="Quản lý Thiết bị">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <TabView IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
            <!-- TAB 1 -->
            <TabViewItem Header="Kho Model" IsClosable="False">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Bo loc -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <TextBox Header="Tên Model" PlaceholderText="Lọc..." Text="{x:Bind ViewModel.ModelNameFilter, Mode=TwoWay}" KeyDown="Filter_KeyDown" Width="200"/>
                        <TextBox Header="Category" PlaceholderText="Lọc..." Text="{x:Bind ViewModel.ModelCategoryFilter, Mode=TwoWay}" KeyDown="Filter_KeyDown" Width="150"/>
                        <TextBox Header="NSX" PlaceholderText="Lọc..." Text="{x:Bind ViewModel.ModelManufacturerFilter, Mode=TwoWay}" KeyDown="Filter_KeyDown" Width="150"/>
                        <Button Content="Tìm kiếm" VerticalAlignment="Bottom" Click="SearchButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>

                    <controls:DataGrid 
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
                        SelectionMode="Single"
                        CanUserSortColumns="True"
                        Sorting="DataGrid_Sorting"
                        GridLinesVisibility="Horizontal"
                        AlternatingRowBackground="{ThemeResource SystemControlBackgroundChromeLowBrush}">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Tên Model" Binding="{Binding Data.Name}" Tag="Name" Width="2*" />
                            <controls:DataGridTextColumn Header="Category" Binding="{Binding Data.Category}" Tag="Category" Width="*" />
                            <controls:DataGridTextColumn Header="NSX" Binding="{Binding Data.Manufacturer}" Tag="Manufacturer" Width="*" />
                            <controls:DataGridTextColumn Header="Sẵn có" Binding="{Binding Data.Available}" Tag="Available" Width="80" FontWeight="Bold" />
                            <controls:DataGridTemplateColumn Header="Thao tác" Width="180">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="viewmodels:ModelDto">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <TextBox Width="60" Text="{x:Bind QuantityToBorrow, Mode=TwoWay}" PlaceholderText="S.L" VerticalAlignment="Center"/>
                                            <Button Content="Borrow" Click="BorrowButton_Click" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <!-- Phan trang -->
                    <Border Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="12" CornerRadius="4" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox SelectedItem="{x:Bind ViewModel.ModelSelectedPageSize, Mode=TwoWay}" Width="80">
                                    <x:String>10</x:String><x:String>20</x:String><x:String>30</x:String><x:String>100</x:String>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ModelPageInfoText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button Content="&lt;&lt;" Command="{x:Bind ViewModel.ModelFirstPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoModelPrev, Mode=OneWay}"/>
                                <Button Content="&lt;" Command="{x:Bind ViewModel.ModelPrevPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoModelPrev, Mode=OneWay}"/>
                                <Button Content="&gt;" Command="{x:Bind ViewModel.ModelNextPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoModelNext, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- TAB 2 -->
            <TabViewItem Header="Danh sách Thiết bị" IsClosable="False">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Bo loc -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <TextBox Header="Tên Thiết bị" PlaceholderText="Lọc..." Text="{x:Bind ViewModel.DeviceNameFilter, Mode=TwoWay}" KeyDown="Filter_KeyDown" Width="200"/>
                        <TextBox Header="Mã Model" PlaceholderText="Lọc..." Text="{x:Bind ViewModel.DeviceModelNameFilter, Mode=TwoWay}" KeyDown="Filter_KeyDown" Width="200"/>
                        <TextBox Header="IMEI" PlaceholderText="Lọc..." Text="{x:Bind ViewModel.DeviceImeiFilter, Mode=TwoWay}" KeyDown="Filter_KeyDown" Width="150"/>
                        <Button Content="Tìm kiếm" VerticalAlignment="Bottom" Click="SearchButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>

                    <controls:DataGrid 
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                        SelectionMode="Single"
                        CanUserSortColumns="True"
                        Sorting="DataGrid_Sorting"
                        GridLinesVisibility="Horizontal"
                        AlternatingRowBackground="{ThemeResource SystemControlBackgroundChromeLowBrush}">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Tên Thiết bị" Binding="{Binding Name}" Tag="Name" Width="2*" />
                            <controls:DataGridTextColumn Header="Mã Model" Binding="{Binding Model.Name}" Tag="ModelName" Width="2*" />
                            <controls:DataGridTextColumn Header="IMEI" Binding="{Binding Imei}" Tag="Imei" Width="1.5*" />
                            <controls:DataGridCheckBoxColumn Header="Đã Mượn" Binding="{Binding IsBorrowed}" Tag="IsBorrowed" Width="Auto" />
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <!-- Phan trang -->
                    <Border Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="12" CornerRadius="4" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox SelectedItem="{x:Bind ViewModel.DeviceSelectedPageSize, Mode=TwoWay}" Width="80">
                                    <x:String>10</x:String><x:String>20</x:String><x:String>30</x:String><x:String>100</x:String>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DevicePageInfoText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button Content="&lt;&lt;" Command="{x:Bind ViewModel.DeviceFirstPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoDevicePrev, Mode=OneWay}"/>
                                <Button Content="&lt;" Command="{x:Bind ViewModel.DevicePrevPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoDevicePrev, Mode=OneWay}"/>
                                <Button Content="&gt;" Command="{x:Bind ViewModel.DeviceNextPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoDeviceNext, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
