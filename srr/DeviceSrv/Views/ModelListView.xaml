<UserControl
    x:Class="DeviceSrv.Views.ModelListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DeviceSrv.ViewModels"
    xmlns:models="using:DeviceSrv.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10" Grid.Row="0">
            <StackPanel.Resources>
                <!-- Hình chữ nhật -->
                <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                <!-- Màu khi Select -->
                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Red" />
                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                <!-- Màu khi Hover (trên nút đang select) -->
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="DarkRed" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
            </StackPanel.Resources>
            
            <TextBlock Text="Device Model Management" Style="{StaticResource HeaderTextBlockStyle}" VerticalAlignment="Center"/>
            <Button Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <SymbolIcon Symbol="Refresh"/><TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>

            <ToggleButton x:Name="OptionAButton" Content="Option A" Width="100" Checked="Option_Checked" IsChecked="True" />
            <ToggleButton x:Name="OptionBButton" Content="Option B" Width="100" Checked="Option_Checked" />
        </StackPanel>

        <controls:DataGrid x:Name="ModelGrid"
                         Grid.Row="1"
                         AutoGenerateColumns="False"
                         ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
                         HeadersVisibility="All"
                         ColumnWidth="*"
                         CanUserSortColumns="True"
                         Sorting="DataGrid_Sorting"
                         RowHeight="70">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="ID" Width="80" Tag="Id" 
                                             Binding="{Binding Id}"
                                             IsReadOnly="True"
                                             HeaderStyle="{StaticResource NoFilterHeaderStyle}"
                                             ElementStyle="{StaticResource DefaultCellTextStyle}"/>
                
                <controls:DataGridTextColumn Width="*" Tag="Name" Header="Name" 
                                             Binding="{Binding Name}"
                                             IsReadOnly="True"
                                             HeaderStyle="{StaticResource AutoSuggestHeaderStyle}"
                                             ElementStyle="{StaticResource DefaultCellTextStyle}"/>

                <controls:DataGridTextColumn Width="*" Tag="Manufacturer" Header="Manufacturer" 
                                             Binding="{Binding Manufacturer}"
                                             IsReadOnly="True"
                                             HeaderStyle="{StaticResource ComboBoxFilterHeaderStyle}"
                                             ElementStyle="{StaticResource DefaultCellTextStyle}"/>

                <controls:DataGridTextColumn Header="Category" Width="*" Tag="Category" 
                                             Binding="{Binding Category}"
                                             IsReadOnly="True"
                                             HeaderStyle="{StaticResource ComboBoxFilterHeaderStyle}"
                                             ElementStyle="{StaticResource DefaultCellTextStyle}"/>

                <controls:DataGridTextColumn Header="Available" Width="*" Tag="Available" 
                                             Binding="{Binding Available}"
                                             IsReadOnly="True"
                                             HeaderStyle="{StaticResource NoFilterHeaderStyle}"
                                             ElementStyle="{StaticResource DefaultCellTextStyle}"/>
                
                <controls:DataGridTemplateColumn Header="Function" Width="100" HeaderStyle="{StaticResource ClearFilterHeaderStyle}">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Model">
                            <Button Content="Borrow" IsEnabled="{Binding Available, Converter={StaticResource GreaterThanZero}}"
                                    Click="Borrow_Click" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Spacing="10">
            <Button Content="First" Click="ModelFirstPage_Click" IsEnabled="{x:Bind ViewModel.CanGoModelPrev, Mode=OneWay}"/>
            <Button Content="Prev" Click="ModelPrevPage_Click" IsEnabled="{x:Bind ViewModel.CanGoModelPrev, Mode=OneWay}"/>
            
            <ItemsControl ItemsSource="{x:Bind ViewModel.ModelPageItems, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaginationItem">
                        <Button Content="{Binding Text}" 
                                Click="PageButton_Click"
                                IsEnabled="{Binding IsClickable}"
                                Background="{Binding IsCurrent, Converter={StaticResource ActiveToBrush}}"
                                Width="40" Height="40" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Next" Click="ModelNextPage_Click" IsEnabled="{x:Bind ViewModel.CanGoModelNext, Mode=OneWay}"/>
            <Button Content="Last" Click="ModelLastPage_Click" IsEnabled="{x:Bind ViewModel.CanGoModelNext, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
