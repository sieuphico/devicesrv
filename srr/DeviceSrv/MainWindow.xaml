<Window
    x:Class="DeviceSrv.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeviceSrv"
    xmlns:vm="using:DeviceSrv.ViewModels"
    xmlns:models="using:DeviceSrv.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="ErrorBar"
                 Severity="Error"
                 Title="System Information"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 HorizontalAlignment="Stretch"
                 Grid.Row="0"/>

        <TabView x:Name="MainTabView" Grid.Row="1">
            <TabViewItem Header="Model List" IsClosable="False">
                <Grid Padding="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="Device Model Management" Style="{StaticResource HeaderTextBlockStyle}"/>
                        <Button Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <SymbolIcon Symbol="Refresh"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Filter Bar aligned with ModelGrid Columns -->
                    <Grid Grid.Row="1" Background="{ThemeResource SystemControlBackgroundAltMediumBrush}" Padding="4" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/> <!-- ID -->
                            <ColumnDefinition Width="*"/>  <!-- Name -->
                            <ColumnDefinition Width="*"/>  <!-- Manufacturer -->
                            <ColumnDefinition Width="*"/>  <!-- Category -->
                            <ColumnDefinition Width="*"/>  <!-- Available -->
                            <ColumnDefinition Width="100"/> <!-- Function -->
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="1" Margin="2,0" PlaceholderText="Search Name..." 
                                 Text="{x:Bind ViewModel.ModelNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="2" Margin="2,0" PlaceholderText="Search Manufacturer..." 
                                 Text="{x:Bind ViewModel.ModelManufacturerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <controls:DataGrid x:Name="ModelGrid"
                                     Grid.Row="2"
                                     AutoGenerateColumns="False"
                                     ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
                                     HeadersVisibility="All"
                                     ColumnWidth="*"
                                     CanUserSortColumns="True"
                                     Sorting="DataGrid_Sorting"
                                     RowHeight="50">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="80" Tag="Id"/>
                            <controls:DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="*" Tag="Name"/>
                            <controls:DataGridTextColumn Binding="{Binding Manufacturer}" Header="Manufacturer" Width="*" Tag="Manufacturer"/>
                            <controls:DataGridTextColumn Binding="{Binding Category}" Header="Category" Width="*" Tag="Category"/>
                            <controls:DataGridTextColumn Binding="{Binding Available}" Header="Available" Width="*" Tag="Available"/>
                            <controls:DataGridTemplateColumn Header="Function" Width="100">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Model">
                                        <Button Content="Borrow" 
                                                IsEnabled="{Binding Available, Converter={StaticResource GreaterThanZero}}"
                                                Click="Borrow_Click"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Device List" IsClosable="False">
                <Grid Padding="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar aligned with DeviceGrid Columns -->
                    <Grid Grid.Row="0" Margin="0,0,0,5" Background="{ThemeResource SystemControlBackgroundAltMediumBrush}" Padding="4" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/> <!-- ID -->
                            <ColumnDefinition Width="*"/>  <!-- Name -->
                            <ColumnDefinition Width="*"/>  <!-- IMEI -->
                            <ColumnDefinition Width="*"/>  <!-- SN -->
                            <ColumnDefinition Width="100"/> <!-- Borrowed -->
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="1" Margin="2,0" PlaceholderText="Search Name..." 
                                 Text="{x:Bind ViewModel.DeviceNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="2" Margin="2,0" PlaceholderText="Search IMEI..." 
                                 Text="{x:Bind ViewModel.DeviceImeiFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="3" Margin="2,0" PlaceholderText="Search SN..." 
                                 Text="{x:Bind ViewModel.DeviceSnFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <controls:DataGrid x:Name="DeviceGrid"
                                     Grid.Row="1"
                                     AutoGenerateColumns="False"
                                     ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                     HeadersVisibility="All"
                                     ColumnWidth="*"
                                     LoadingRow="DeviceGrid_LoadingRow"
                                     CanUserSortColumns="True"
                                     Sorting="DataGrid_Sorting"
                                     RowHeight="50">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="80" Tag="Id"/>
                            <controls:DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="*" Tag="Name"/>
                            <controls:DataGridTextColumn Binding="{Binding Imei}" Header="IMEI" Width="*" Tag="Imei"/>
                            <controls:DataGridTextColumn Binding="{Binding SerialNumber}" Header="Serial Number" Width="*" Tag="SerialNumber"/>
                            <controls:DataGridCheckBoxColumn Header="Borrowed" Binding="{Binding IsBorrowed}" Width="100" Tag="IsBorrowed"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Total:" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Rows per page:" VerticalAlignment="Center"/>
                            <ComboBox SelectedValue="{x:Bind ViewModel.PageSize, Mode=TwoWay}" Width="80">
                                <x:Int32>10</x:Int32>
                                <x:Int32>20</x:Int32>
                                <x:Int32>30</x:Int32>
                                <x:Int32>50</x:Int32>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="&lt;" Click="PrevPage_Click" IsEnabled="{x:Bind ViewModel.CanGoPrev, Mode=OneWay}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"/>
                                <TextBlock Text=" / "/>
                                <TextBlock Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}"/>
                            </StackPanel>
                            <Button Content="&gt;" Click="NextPage_Click" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
