<Window
    x:Class="DeviceSrv.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeviceSrv"
    xmlns:vm="using:DeviceSrv.ViewModels"
    xmlns:models="using:DeviceSrv.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- BindingProxy is the bridge for stable HeaderTemplate filtering -->
            <local:BindingProxy x:Key="Proxy"/>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="ErrorBar"
                 Severity="Error"
                 Title="System Information"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 HorizontalAlignment="Stretch"
                 Grid.Row="0"/>

        <TabView x:Name="MainTabView" Grid.Row="1">
            <TabViewItem Header="Model List" IsClosable="False">
                <Grid Padding="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="Device Model Management" Style="{StaticResource HeaderTextBlockStyle}"/>
                        <Button Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <SymbolIcon Symbol="Refresh"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <controls:DataGrid x:Name="ModelGrid"
                                     Grid.Row="1"
                                     AutoGenerateColumns="False"
                                     ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
                                     HeadersVisibility="All"
                                     ColumnWidth="*"
                                     CanUserSortColumns="True"
                                     Sorting="DataGrid_Sorting"
                                     RowHeight="70">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="80" Tag="Id"/>
                            
                            <controls:DataGridTemplateColumn Width="*" Tag="Name" Header="Name">
                                <controls:DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="primitives:DataGridColumnHeader">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Loaded="FilterGrid_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="8,10" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <AutoSuggestBox Grid.Row="1" Margin="2,2,2,4" PlaceholderText="Filter..." Height="32" HorizontalAlignment="Stretch" QueryIcon="Find"
                                                                        Text="{Binding Source={StaticResource Proxy}, Path=Data.ModelNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </controls:DataGridTemplateColumn.HeaderStyle>
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Model">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <controls:DataGridTemplateColumn Width="*" Tag="Manufacturer" Header="Manufacturer">
                                <controls:DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="primitives:DataGridColumnHeader">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Loaded="FilterGrid_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="8,10" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <AutoSuggestBox Grid.Row="1" Margin="2,2,2,4" PlaceholderText="Filter..." Height="32" HorizontalAlignment="Stretch" QueryIcon="Find"
                                                                        Text="{Binding Source={StaticResource Proxy}, Path=Data.ModelManufacturerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </controls:DataGridTemplateColumn.HeaderStyle>
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Model">
                                        <TextBlock Text="{Binding Manufacturer}" VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <controls:DataGridTemplateColumn Width="*" Tag="Category" Header="Category">
                                <controls:DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="primitives:DataGridColumnHeader">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Loaded="FilterGrid_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="8,10" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ComboBox Grid.Row="1" Margin="2,2,2,4" ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.ModelCategories}"
                                                                  SelectedItem="{Binding Source={StaticResource Proxy}, Path=Data.ModelCategoryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Height="32" HorizontalAlignment="Stretch"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </controls:DataGridTemplateColumn.HeaderStyle>
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Model">
                                        <TextBlock Text="{Binding Category}" VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="*" Tag="Available"/>
                            
                            <controls:DataGridTemplateColumn Header="Function" Width="100">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Model">
                                        <Button Content="Borrow" 
                                                IsEnabled="{Binding Available, Converter={StaticResource GreaterThanZero}}"
                                                Click="Borrow_Click"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Device List" IsClosable="False">
                <Grid Padding="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <controls:DataGrid x:Name="DeviceGrid"
                                     AutoGenerateColumns="False"
                                     ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                     HeadersVisibility="All"
                                     ColumnWidth="*"
                                     LoadingRow="DeviceGrid_LoadingRow"
                                     CanUserSortColumns="True"
                                     Sorting="DataGrid_Sorting"
                                     RowHeight="70">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="80" Tag="Id"/>
                            
                            <controls:DataGridTemplateColumn Width="*" Tag="Name" Header="Name">
                                <controls:DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="primitives:DataGridColumnHeader">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Loaded="FilterGrid_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="8,10" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <AutoSuggestBox Grid.Row="1" Margin="2,2,2,4" PlaceholderText="Search..." Height="32" HorizontalAlignment="Stretch" QueryIcon="Find"
                                                                        Text="{Binding Source={StaticResource Proxy}, Path=Data.DeviceNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </controls:DataGridTemplateColumn.HeaderStyle>
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Device">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <controls:DataGridTemplateColumn Width="*" Tag="Imei" Header="IMEI">
                                <controls:DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="primitives:DataGridColumnHeader">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Loaded="FilterGrid_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="8,10" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <AutoSuggestBox Grid.Row="1" Margin="2,2,2,4" PlaceholderText="Search..." Height="32" HorizontalAlignment="Stretch" QueryIcon="Find"
                                                                        Text="{Binding Source={StaticResource Proxy}, Path=Data.DeviceImeiFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </controls:DataGridTemplateColumn.HeaderStyle>
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Device">
                                        <TextBlock Text="{Binding Imei}" VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <controls:DataGridTemplateColumn Width="*" Tag="SerialNumber" Header="Serial Number">
                                <controls:DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="primitives:DataGridColumnHeader">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Loaded="FilterGrid_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="8,10" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <AutoSuggestBox Grid.Row="1" Margin="2,2,2,4" PlaceholderText="Search..." Height="32" HorizontalAlignment="Stretch" QueryIcon="Find"
                                                                        Text="{Binding Source={StaticResource Proxy}, Path=Data.DeviceSnFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </controls:DataGridTemplateColumn.HeaderStyle>
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Device">
                                        <TextBlock Text="{Binding SerialNumber}" VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <controls:DataGridCheckBoxColumn Header="Borrowed" Binding="{Binding IsBorrowed}" Width="100" Tag="IsBorrowed"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Total:" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Rows per page:" VerticalAlignment="Center"/>
                            <ComboBox SelectedValue="{x:Bind ViewModel.PageSize, Mode=TwoWay}" Width="80">
                                <x:Int32>10</x:Int32>
                                <x:Int32>20</x:Int32>
                                <x:Int32>30</x:Int32>
                                <x:Int32>50</x:Int32>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="&lt;" Click="PrevPage_Click" IsEnabled="{x:Bind ViewModel.CanGoPrev, Mode=OneWay}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"/>
                                <TextBlock Text=" / "/>
                                <TextBlock Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}"/>
                            </StackPanel>
                            <Button Content="&gt;" Click="NextPage_Click" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
