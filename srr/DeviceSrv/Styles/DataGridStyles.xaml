<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeviceSrv"
    xmlns:behaviors="using:DeviceSrv.Behaviors"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives">

    <SolidColorBrush x:Key="ShrimpPastePurple" Color="#5D3F6A"/>

    <Style x:Key="BaseColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- Default style for TextBlocks in cells -->
    <Style x:Key="DefaultCellTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0"/>
    </Style>

    <!-- Reusable Header Style WITHOUT Filter -->
    <Style x:Key="NoFilterHeaderStyle" TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource BaseColumnHeaderStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid behaviors:DataGridFilterBehavior.IsFilterHeader="True" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{StaticResource ShrimpPastePurple}" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" Margin="10,0"/>
                        </Grid>
                        <Border Grid.Row="1" Height="40" Margin="2,0,2,0"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Unified Style for AutoSuggestBox Headers -->
    <Style x:Key="AutoSuggestHeaderStyle" TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource BaseColumnHeaderStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid behaviors:DataGridFilterBehavior.IsFilterHeader="True" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{StaticResource ShrimpPastePurple}" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" Margin="10,0"/>
                        </Grid>
                        <AutoSuggestBox Grid.Row="1" Margin="2,4,2,4" PlaceholderText="Filter..." Height="32" HorizontalAlignment="Stretch" QueryIcon="Find"
                                        behaviors:DataGridFilterBehavior.EnableAutoFilter="True"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Unified Generic Style for ComboBox Headers -->
    <Style x:Key="ComboBoxFilterHeaderStyle" TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource BaseColumnHeaderStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid behaviors:DataGridFilterBehavior.IsFilterHeader="True" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{StaticResource ShrimpPastePurple}" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" Margin="10,0"/>
                        </Grid>
                        <ComboBox Grid.Row="1" Margin="2,4,2,4" behaviors:DataGridFilterBehavior.EnableComboBoxFilter="True"
                                  HorizontalAlignment="Stretch" Height="32"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
