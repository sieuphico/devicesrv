<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeviceSrv"
    xmlns:behaviors="using:DeviceSrv.Behaviors"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives">

    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="LightGray"/>

    <Style x:Key="BaseColumnHeaderStyle" TargetType="primitives:DataGridColumnHeader">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- Default style for TextBlocks in cells -->
    <Style x:Key="DefaultCellTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0"/>
    </Style>

    <!-- Reusable Header Style WITHOUT Filter -->
    <Style x:Key="NoFilterHeaderStyle" TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource BaseColumnHeaderStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid behaviors:DataGridFilterBehavior.IsFilterHeader="True" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="Black" Margin="10,0,30,0"/>
                            <FontIcon behaviors:DataGridFilterBehavior.IsCustomSortIcon="True" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Glyph="&#xE8CB;" />
                        </Grid>
                        <Border Grid.Row="1" Height="40" Margin="2,0,2,0"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Unified Style for AutoSuggestBox Headers -->
    <Style x:Key="AutoSuggestHeaderStyle" TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource BaseColumnHeaderStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid behaviors:DataGridFilterBehavior.IsFilterHeader="True" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="Black" Margin="10,0,30,0"/>
                            <FontIcon behaviors:DataGridFilterBehavior.IsCustomSortIcon="True" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Glyph="&#xE8CB;" />
                        </Grid>
                        <AutoSuggestBox Grid.Row="1" Margin="2,4,2,4" PlaceholderText="Filter..." Height="32" HorizontalAlignment="Stretch" QueryIcon="Find"
                                        behaviors:DataGridFilterBehavior.EnableAutoFilter="True"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Unified Generic Style for Custom Searchable Headers -->
    <Style x:Key="ComboBoxFilterHeaderStyle" TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource BaseColumnHeaderStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid behaviors:DataGridFilterBehavior.IsFilterHeader="True" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="Black" Margin="10,0,30,0"/>
                            <FontIcon behaviors:DataGridFilterBehavior.IsCustomSortIcon="True" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Glyph="&#xE8CB;" />
                        </Grid>
                        
                        <!-- Custom Searchable Picker Button -->
                        <Button Grid.Row="1" Margin="2,4,2,4" 
                                behaviors:DataGridFilterBehavior.EnableCustomSearchFilter="True"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="32" 
                                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                BorderThickness="1" BorderBrush="LightGray" Padding="8,0">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Grid Width="250" Height="400">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="FilterSearchBox" PlaceholderText="Search..." Margin="0,0,0,8" />
                                        <ListView x:Name="FilterListView" Grid.Row="1" SelectionMode="Single" />
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                            <Grid HorizontalAlignment="Stretch">
                                <TextBlock x:Name="SelectedValueText" Text="Filter..." Foreground="Gray" VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE70D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                        </Button>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for ComboBox Headers with Clear button -->
    <Style x:Key="ClearFilterHeaderStyle" TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource BaseColumnHeaderStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid behaviors:DataGridFilterBehavior.IsFilterHeader="True" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="Black" Margin="10,0,30,0"/>
                            <FontIcon behaviors:DataGridFilterBehavior.IsCustomSortIcon="True" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Glyph="&#xE8CB;" />
                        </Grid>
                        <Button Grid.Row="1" Content="Clear" Margin="4" 
                                behaviors:DataGridFilterBehavior.EnableClearFilter="True"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="32"
                                FontSize="12" Padding="0"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
